{
  "name": "stremio-lite-tizenbrew",
  "version": "3.1.2",
  "private": true,
  "description": "Unofficial Stremio-compatible client for older Samsung TVs. ES5 client targeting Tizen 3.0.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ws3r211/stremio-lite-tizenbrew.git"
  },
  "packageType": "app",
  "appName": "Stremio Lite Auto",
  "appPath": "auto/loader.html",
  "serviceFile": "auto/service.js",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaRewind",
    "MediaFastForward"
  ],
  "scripts": {
    "start": "node service.js",
    "test": "node test/core.test.cjs"
  },
  "files": [
    "app",
    "service.js",
    "README.md",
    "LICENSE",
    "auto",
    "runtime.json",
    "update.json"
  ],
  "devDependencies": {
    "acorn": "^8.15.0"
  }
}
